#!/usr/bin/env python3
"""
File: src/analytical_tools/sensor_emulator.py
Author: Sulaimanov Baibol (GitHub: cilan1m0 / CilaNim)
Course: Electronic Components and Circuits (EEAIR)
Description:
    Simulates an ESP32 analog sensor stream on GPIO36 generating a 0.5 Hz
    sinusoidal wave (1.65V DC offset, 0.45V amplitude), Gaussian white noise
    (sigma = 0.04V), and random 5% probability voltage spike anomalies.
    Replicates the N=50 Ring Buffer and Z-Score edge filter and publishes
    telemetry packets over MQTT to Eclipse Mosquitto.
"""

import argparse
import collections
import json
import math
import random
import time
from typing import Deque, Dict, Any

import numpy as np
import paho.mqtt.client as mqtt


class EdgeSensorEmulator:
    """Emulates the ESP32 analog front-end, N=50 Ring Buffer, and Z-Score filter."""

    def __init__(
        self,
        broker_host: str = "127.0.0.1",
        broker_port: int = 1883,
        telemetry_topic: str = "eeair/cilan1m0/edge/telemetry",
        raw_reference_topic: str = "eeair/cilan1m0/edge/raw_reference",
        window_size: int = 50,
        z_threshold: float = 2.5,
        sample_rate_hz: float = 10.0,
        spike_probability: float = 0.05,
        random_seed: int = 2026,
    ) -> None:
        self.broker_host = broker_host
        self.broker_port = broker_port
        self.telemetry_topic = telemetry_topic
        self.raw_reference_topic = raw_reference_topic
        self.window_size = window_size
        self.z_threshold = z_threshold
        self.sample_period_s = 1.0 / sample_rate_hz
        self.spike_probability = spike_probability

        # Fixed PRNG seeds for deterministic, reproducible grading results
        random.seed(random_seed)
        np.random.seed(random_seed)

        self.ring_buffer: Deque[float] = collections.deque(maxlen=self.window_size)
        self.sample_id = 0
        self.published_packets = 0
        self.dropped_packets = 0

        self.mqtt_client = mqtt.Client(
            client_id=f"emulator_cilan1m0_sigma_{self.z_threshold:.1f}"
        )

    def connect_broker(self) -> None:
        """Connects to the Eclipse Mosquitto MQTT broker."""
        self.mqtt_client.connect(self.broker_host, self.broker_port, keepalive=60)
        self.mqtt_client.loop_start()
        print(
            f"[EMULATOR] Connected to MQTT Broker {self.broker_host}:{self.broker_port} "
            f"| Threshold = {self.z_threshold:.2f} sigma"
        )

    def disconnect_broker(self) -> None:
        """Stops the MQTT background thread and disconnects cleanly."""
        self.mqtt_client.loop_stop()
        self.mqtt_client.disconnect()
        print("[EMULATOR] Disconnected from MQTT Broker.")

    def synthesize_voltage(self, elapsed_s: float) -> tuple[float, bool]:
        """
        Generates an analog sample within the ESP32 0.0V - 3.3V ADC range:
          - 0.5 Hz sine wave carrier: 1.65V + 0.45V * sin(2 * pi * 0.5 * t)
          - Gaussian white noise: N(0, 0.04^2)
          - Random 5% voltage spike anomaly during steady-state operation
        """
        sine_carrier = 1.65 + 0.45 * math.sin(2.0 * math.pi * 0.5 * elapsed_s)
        gaussian_noise = float(np.random.normal(0.0, 0.04))
        voltage = sine_carrier + gaussian_noise

        is_ground_truth_spike = False
        if len(self.ring_buffer) == self.window_size and random.random() < self.spike_probability:
            is_ground_truth_spike = True
            direction = random.choice([-1.0, 1.0])
            magnitude = random.uniform(1.10, 1.45)
            voltage += direction * magnitude

        voltage = max(0.0, min(3.3, voltage))
        return voltage, is_ground_truth_spike

    def compute_window_stats(self) -> tuple[float, float]:
        """Calculates rolling mean (mu) and population standard deviation (sigma)."""
        if not self.ring_buffer:
            return 0.0, 0.0
        window_array = np.array(self.ring_buffer, dtype=np.float64)
        return float(np.mean(window_array)), float(np.std(window_array, ddof=0))

    def step_simulation(self, elapsed_s: float, publish_mqtt: bool = True) -> Dict[str, Any]:
        """Executes a single sampling and Z-score filtering step."""
        self.sample_id += 1
        voltage, is_ground_truth_spike = self.synthesize_voltage(elapsed_s)

        if len(self.ring_buffer) < self.window_size:
            self.ring_buffer.append(voltage)
            mu, sigma = self.compute_window_stats()
            z_score = 0.0
            status = "WARMUP"
            transmit = True
        else:
            mu, sigma = self.compute_window_stats()
            safe_sigma = max(sigma, 1e-6)
            z_score = (voltage - mu) / safe_sigma
            self.ring_buffer.append(voltage)

            if abs(z_score) >= self.z_threshold:
                status = "ANOMALY"
                transmit = True
            else:
                status = "FILTERED"
                transmit = False

        if transmit:
            self.published_packets += 1
        else:
            self.dropped_packets += 1

        payload_dict = {
            "node_id": "esp32_edge_node_cilan1m0",
            "sample_id": self.sample_id,
            "timestamp": int(elapsed_s * 1000),
            "voltage_v": round(voltage, 4),
            "rolling_mu": round(mu, 4),
            "rolling_std": round(sigma, 4),
            "z_score": round(z_score, 3),
            "threshold": self.z_threshold,
            "status": status,
            "is_ground_truth_spike": is_ground_truth_spike,
            "published": self.published_packets,
            "dropped": self.dropped_packets,
        }

        serialized_json = json.dumps(payload_dict, separators=(",", ":"))
        payload_dict["_byte_size"] = len(serialized_json.encode("utf-8"))

        if publish_mqtt:
            self.mqtt_client.publish(self.raw_reference_topic, serialized_json, qos=0)
            if transmit:
                self.mqtt_client.publish(self.telemetry_topic, serialized_json, qos=0)

        return payload_dict

    def run_stream(self, duration_s: float = 120.0, realtime: bool = True) -> None:
        """Runs continuous sensor emulation over the specified duration."""
        self.connect_broker()
        total_steps = int(duration_s / self.sample_period_s)
        start_wall_clock = time.time()

        try:
            for idx in range(total_steps):
                sim_timestamp = idx * self.sample_period_s
                packet = self.step_simulation(sim_timestamp, publish_mqtt=True)
                saved_pct = (self.dropped_packets / self.sample_id) * 100.0

                if packet["status"] in ("WARMUP", "ANOMALY"):
                    print(
                        f"[{packet['status']:7s}] Sample #{packet['sample_id']:04d} | "
                        f"V={packet['voltage_v']:.4f}V | Z={packet['z_score']:+6.2f} | "
                        f"Spike={str(packet['is_ground_truth_spike']):5s} | "
                        f"Bandwidth Saved={saved_pct:5.1f}%"
                    )

                if realtime:
                    next_tick = start_wall_clock + ((idx + 1) * self.sample_period_s)
                    sleep_delay = next_tick - time.time()
                    if sleep_delay > 0:
                        time.sleep(sleep_delay)
        except KeyboardInterrupt:
            print("\n[EMULATOR] Stream stopped by user.")
        finally:
            self.disconnect_broker()


def main() -> None:
    parser = argparse.ArgumentParser(
        description="ESP32 Analog Sensor & Z-Score Filter Emulator (MQTT)"
    )
    parser.add_argument("--host", type=str, default="127.0.0.1", help="MQTT Broker IP/Host")
    parser.add_argument("--port", type=int, default=1883, help="MQTT Broker Port")
    parser.add_argument("--threshold", type=float, default=2.5, help="Z-score threshold (sigma)")
    parser.add_argument("--duration", type=float, default=120.0, help="Simulation duration (s)")
    parser.add_argument("--fast", action="store_true", help="Disable wall-clock sleep delays")
    args = parser.parse_args()

    emulator = EdgeSensorEmulator(
        broker_host=args.host,
        broker_port=args.port,
        z_threshold=args.threshold,
    )
    emulator.run_stream(duration_s=args.duration, realtime=not args.fast)


if __name__ == "__main__":
    main()
